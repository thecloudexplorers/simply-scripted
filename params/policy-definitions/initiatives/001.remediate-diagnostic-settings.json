          "displayName": "Log Analytics",
          "description": "Resource ID of the Log Analytics workspace that receives the diagnostic settings",
          "strongType": "omsWorkspace",
          "assignPermissions": true
        }
      },
      "logsEnabled": {
        "type": "boolean",
        "metadata": {
          "displayName": "Enable logs",
          "description": "Enable logs"
        },
        "defaultValue": true
